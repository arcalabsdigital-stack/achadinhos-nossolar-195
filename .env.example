# Banco (Railway Postgres)
DATABASE_URL=postgresql://user:pass@host:5432/db

# URL pública do app (usada nos links curtos /o/[id])
APP_URL=https://achadinhos.up.railway.app

# Senha do painel (usuário: admin)
PANEL_PASSWORD=troque-esta-senha

# Shopee Afiliados — Open API (conta da Taty)
SHOPEE_APP_ID=
SHOPEE_APP_SECRET=

# Claude API
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Evolution API
EVOLUTION_URL=https://evolution.up.railway.app
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=achadinhos

# Envio desligado por padrão: true = envia de verdade no WhatsApp
SENDING_ENABLED=false

# Amazon Associados — tag aplicada nos links da Amazon
AMAZON_TAG=nossolar195-20

# Agendador roda dentro do serviço web. Use false só se criar um serviço worker separado (npm run worker)
WORKER_IN_WEB=true

# IA para nota e texto das ofertas (opcional). Gemini tem plano gratuito; se as duas estiverem definidas, usa o Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
